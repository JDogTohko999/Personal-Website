{
  "rewrites": [
    { "source": "/pool", "destination": "/pool/index.html" },
    { "source": "/pool/:slug", "destination": "/pool/:slug/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/pool/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noimageindex" }]
    }
  ]
}
